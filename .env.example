# For running from source (`npm start` / `npm run dev`), which loads this file.
# The Docker path does NOT read this — set the compose variables (CONFIG_PATH,
# DATA_PATH, PUID, ...) in a .env next to docker-compose.yml instead; see
# docker-compose.example.yml.

# Optional. Overrides the time zone chosen in Freetvarr's settings; TVHeadend follows the host clock without it.
# TZ=Australia/Sydney
PUID=1000
PGID=1000

# Optional. Overrides the secret Freetvarr generates and saves to its config folder.
# CSRF_SECRET=

# Only relevant when running from source (Docker sets these in the compose file
# instead). RECORDINGS_ROOT is where freetvarr looks for TVHeadend's recording
# files; TVH_RECORDINGS_PATH is the path TVHeadend itself uses for the same
# files, as recorded in TVHeadend's own database. Point both at the same
# files (directly, or via a bind-mount/symlink) so freetvarr can hardlink a
# finished recording into MEDIA_ROOT for Plex. Keep RECORDINGS_ROOT and
# MEDIA_ROOT on one disk; under Docker, in one mount.
# RECORDINGS_ROOT=/path/to/tvheadend/recordings
# TVH_RECORDINGS_PATH=/path/to/tvheadend/recordings

# Optional. Container path to Plex's Preferences.xml. Only relevant if you mount
# Plex's config into the container so the "Auto-detect from local Plex" Settings
# button can fish out PlexOnlineToken. Leave blank (and skip the bind-mount in
# docker-compose) if Plex doesn't run on this host — the button degrades gracefully.
# PLEX_PREFS_PATH=/plex-preferences.xml
