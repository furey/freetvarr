{
  "name": "freetvarr",
  "version": "1.5.2",
  "author": "James Furey (https://about.me/jamesfurey)",
  "description": "A self-hosted companion for TVHeadend and compatible tuners: watch live TV in the browser, browse the guide, schedule recordings, and sync them into Plex.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furey/freetvarr.git"
  },
  "homepage": "https://furey.github.io/freetvarr/",
  "keywords": [
    "plex",
    "tvheadend",
    "hdhomerun",
    "dvb",
    "dvb-t",
    "atsc",
    "tuner",
    "free-to-air",
    "freeview",
    "dvr",
    "pvr",
    "recordings",
    "media-server",
    "self-hosted",
    "docker",
    "arr",
    "plex-media-server",
    "australia"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "11.15.0"
  },
  "overrides": {
    "qs": "^6.15.2"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts && npm run rebuild:natives && npm audit signatures",
    "rebuild:natives": "npm rebuild --ignore-scripts=false better-sqlite3",
    "migrate": "mkdir -p config && knex migrate:latest",
    "migrate:refresh": "rm -f ./config/state.db && mkdir -p config && knex migrate:latest",
    "start": "npm run migrate && node --env-file-if-exists=.env src/server.js",
    "dev": "npm run migrate && node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test 'test/*.test.js'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/*.test.js'",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "12.11.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.0.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "fast-xml-parser": "5.11.1",
    "fuse.js": "^7.0.0",
    "helmet": "^8.0.0",
    "hls.js": "1.7.3",
    "knex": "^3.1.0",
    "node-cron": "^4.2.1",
    "pretty-ms": "^9.0.0",
    "vue": "^3.5.13"
  }
}
